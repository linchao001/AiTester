HOST=127.0.0.1
PORT=8000

# 模型提供商：mock / deepseek / dashscope
LLM_PROVIDER=mock

# DeepSeek（OpenAI 兼容协议），Key 在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 通义千问 DashScope 兼容模式，Key 在 https://bailian.console.aliyun.com 申请
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-max
